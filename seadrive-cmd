#!/usr/bin/env python3
"""
SeaDrive command helper for Dolphin integration.
Sends commands to SeaDrive GUI via Unix socket.
Handles show-history specially to fix URL encoding bug.
"""

import socket
import struct
import sys
import os
import subprocess
import sqlite3
import urllib.parse

SOCKET_PATH = os.path.expanduser("~/.seadrive/seadrive_ext.sock")
REPO_DB_PATH = os.path.expanduser("~/.seadrive/data/repo.db")
SEADRIVE_MOUNT = os.path.expanduser("~/SeaDrive")

def get_repo_info(file_path: str):
    """Get repo_id, server, and path within repo from a file path."""
    try:
        # Normalize and get path relative to SeaDrive mount
        abs_path = os.path.abspath(file_path)
        if not abs_path.startswith(SEADRIVE_MOUNT):
            return None, None, None

        rel_path = abs_path[len(SEADRIVE_MOUNT):].lstrip('/')

        # Query database for repo mappings
        conn = sqlite3.connect(REPO_DB_PATH)
        cursor = conn.cursor()
        cursor.execute("SELECT server, repo_id, display_name FROM AccountRepos")
        repos = cursor.fetchall()
        conn.close()

        # Find matching repo (longest match wins)
        best_match = None
        for server, repo_id, display_name in repos:
            if rel_path.startswith(display_name):
                if best_match is None or len(display_name) > len(best_match[2]):
                    best_match = (server, repo_id, display_name)

        if best_match:
            server, repo_id, display_name = best_match
            # Get path within the repo (after the library name)
            path_in_repo = rel_path[len(display_name):]
            if not path_in_repo.startswith('/'):
                path_in_repo = '/' + path_in_repo
            return server, repo_id, path_in_repo

        return None, None, None
    except Exception as e:
        print(f"Error getting repo info: {e}", file=sys.stderr)
        return None, None, None

def open_file_history(file_path: str) -> bool:
    """Open file history in browser with correct URL."""
    server, repo_id, path_in_repo = get_repo_info(file_path)

    if not server or not repo_id:
        print(f"Could not find repo info for: {file_path}", file=sys.stderr)
        return False

    # Build correct URL - encode spaces but NOT slashes
    encoded_path = urllib.parse.quote(path_in_repo, safe='/')
    url = f"{server}/repo/file_revisions/{repo_id}/?p={encoded_path}"

    try:
        subprocess.run(['xdg-open', url], check=True)
        return True
    except Exception as e:
        print(f"Error opening URL: {e}", file=sys.stderr)
        return False

def send_command(command: str, path: str = None) -> bool:
    """Send command to SeaDrive socket."""
    try:
        sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        sock.connect(SOCKET_PATH)

        # Tab-separated format: command\tpath
        if path:
            cmd = f'{command}\t{path}'
        else:
            cmd = command

        data = cmd.encode('utf-8')
        sock.sendall(struct.pack('<I', len(data)) + data)

        # Read response (even if empty, to complete the protocol).
        # Query commands (is-file-cached, is-file-in-repo, show-accounts)
        # answer with a length-prefixed string; print it.
        sock.settimeout(2)
        try:
            hdr = sock.recv(4)
            if len(hdr) == 4:
                n = struct.unpack('<I', hdr)[0]
                if n:
                    print(sock.recv(n).decode('utf-8', 'replace'))
        except socket.timeout:
            pass

        sock.close()
        return True
    except Exception as e:
        print(f"Error: {e}", file=sys.stderr)
        return False

def main():
    if len(sys.argv) < 2:
        print("Usage: seadrive-cmd <command> [path]")
        print("Commands: get-share-link, get-internal-link, download, uncache,")
        print("          lock-file, unlock-file, show-history, show-accounts,")
        print("          is-file-cached, is-file-in-repo")
        sys.exit(1)

    command = sys.argv[1]
    path = sys.argv[2] if len(sys.argv) > 2 else None

    # Handle show-history specially to fix URL encoding bug
    if command == 'show-history' and path:
        if open_file_history(path):
            sys.exit(0)
        else:
            sys.exit(1)

    # All other commands go through the socket
    if send_command(command, path):
        sys.exit(0)
    else:
        sys.exit(1)

if __name__ == "__main__":
    main()
